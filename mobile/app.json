{
  "expo": {
    "name": "First Move: Start Small",
    "slug": "first-move-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "firstmove",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.firstmove.mobile",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.firstmove.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow First Move: Start Small to select one toothbrush photo for a check. The app does not keep the photo.",
          "cameraPermission": "Allow First Move: Start Small to take one toothbrush photo for a check. The app does not keep the photo.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ef52228-ecb5-4fa5-939a-fee14d231423"
      }
    }
  }
}
